#-- `---/101 -----------------------------------------------------------------#
# core.sh-isa: Encoding definitions for the SuperH ISA
#
# This files provides SuperH instruction encodings as well as the skeleton of a
# "switch-decide tree" decoder. The "switch-decide tree" is a tree whose nodes
# are switch statements and whose leaves are decisions about which instruction
# is being decoded.
#
# The encodings of ldc/lds give us a canonical numbering of special registers:
#   CONTROL: 0=sr 1=gbr 2=vbr 3=ssr 4=spc 5=mod 6=rs 7=re 8-15=r[0..7]_bank
#   SPECIAL: 0=mach 1=macl 2=pr 3=sgr* 4=/ 5=/ 6=dsr 7=a0 8=x0 9=x1 10=y0
#            11=y1 12=/ 13=/ 14=/ 15=dbr*
#   [*] technically ldc, encoded like lds
#
# Instructions in the table can be tagged with flags written "!flag" indicating
# ISA variations or extensions so that the decoder can emulate multiple
# processor types. This annotation need not be complete; it is used to generate
# a compatibility check automatically but such a check can also be added by an
# instruction's implementation. For instance, lds/sts/ldc/stc[.l] are !sh4/!dsp
# for some registers.
#---

switch($[12:4]) {
    0: switch($[0:4]) {
        2, 4..7, 10, 12..15: decide($[8:4], $[4:4])
        3: switch($[4:4]) decide($[8:4])
        8, 9, 11: switch($[4:4]) decide($[8:4])
    }
    1, 5: decide($[8:4], $[4:4], $[0:4])
    2, 3, 6: switch($[0:4]) decide($[8:4], $[4:4])
    4: switch($[0:4]) {
        2, 3, 6, 7, 10, 12..15: decide($[8:4], $[4:4])
        _: switch($[4:4]) decide($[8:4])
    }
    7, 9, 13, 14: decide($[8:4], $[0:8])
    8: switch($[8:4]) {
        0, 1, 4, 5: decide($[4:4], $[0:4])
        _: decide($[0:8])
    }
    10, 11: decide($[0:12])
    12: switch($[8:4]) decide($[0:8])
}

